[submodule "thirds/geant4"]
	path = thirds/geant4
	url = https://gitlab.cern.ch/geant4/geant4.git
[submodule "thirds/json"]
	path = thirds/json
	url = https://github.com/nlohmann/json.git
[submodule "thirds/quickjs/quickjs"]
	path = thirds/quickjs/quickjs
	url = https://github.com/bellard/quickjs.git
[submodule "thirds/evolvo"]
	path = thirds/evolvo
	url = https://github.com/Geckos-Ink/evolvo.git
[submodule "thirds/v8"]
	path = thirds/v8
	url = https://chromium.googlesource.com/v8/v8.git
[submodule "thirds/lean4"]
	path = thirds/lean4
	url = https://github.com/leanprover/lean4.git
	branch = master
	shallow = true
[submodule "thirds/mathlib4"]
	path = thirds/mathlib4
	url = https://github.com/leanprover-community/mathlib4.git
	branch = master
	shallow = true

    },
    {
      "id": "pair.exchange_conserves_total",
      "role": "invariant",
      "statement": "Over the reals, an antisymmetric pair preserves the sum of a field when both the increment and the time-integrated rate are applied with opposite signs and no bounds clip the resulting state.",
      "lean": {
        "file": "formal/Trech/Methods/PairInteraction.lean",
        "declarations": ["Trech.Methods.PairInteraction.exchange_preserves_sum"]
      },
      "classic": [{"path": "src/ml/PairInteraction.cpp", "cites": "Trech.Methods.PairInteraction"}],

{
  "schema": "trech_formal_laws_v1",
  "note": "Law pairs: a classic C++/JS implementation (the running path) and its optional Lean definition (validation). tests/test_formal_law_pairs.py checks that both sides exist and cite each other; tests/test_formal_laws.cpp runs the classic conformance checks. Lean proofs are checked only by the opt-in trech_formal_lean_build CTest (TRECH_ENABLE_LEAN_CHECK).",
  "laws": [
    {
      "id": "compton.transfer_within_edge",
      "role": "reference",
      "statement": "For eps >= 0 and -1 <= cos(theta) <= 1, the electron's share T/E = 1 - 1/(1 + eps(1 - cos theta)) lies in [0, 2 eps / (1 + 2 eps)], with the edge reached at back-scatter.",
      "lean": {
        "file": "formal/Trech/Laws/Compton.lean",
        "declarations": [
          "Trech.Laws.Compton.transferFraction_nonneg",
          "Trech.Laws.Compton.transferFraction_le_edge",
          "Trech.Laws.Compton.transferFraction_backscatter"
        ]
      },
      "classic": [
        {"path": "include/trech/sim/KleinNishina.hpp", "cites": "Trech.Laws.Compton"},
        {"path": "js/trech_formal_laws.js", "cites": "Trech.Laws.Compton"}
      ],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["compton.transfer_within_edge", "compton.edge_at_backscatter", "compton.cpp_js_ratio", "compton.cpp_js_edge"]}
    },
    {
      "id": "attenuation.memoryless",
      "role": "reference",
      "statement": "Beer-Lambert survival S(x) = exp(-mu x) satisfies S(x + y) = S(x) S(y), S(0) = 1, 0 < S <= 1 for mu, x >= 0, and decreases with path length.",
      "lean": {
        "file": "formal/Trech/Laws/Attenuation.lean",
        "declarations": [
          "Trech.Laws.Attenuation.survival_add",
          "Trech.Laws.Attenuation.survival_le_one",
          "Trech.Laws.Attenuation.survival_antitone"
        ]
      },
      "classic": [
        {"path": "src/sim/AnalyticCrossCheck.cpp", "cites": "Trech.Laws.Attenuation"},
        {"path": "js/trech_formal_laws.js", "cites": "Trech.Laws.Attenuation"}
      ],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["attenuation.memoryless"]}
    },
    {
      "id": "energy.step_balance",
      "role": "reference",
      "statement": "A recorded step conserves energy when E_pre + Q = E_post + sum T_i + d (zero residual), Q being the rest-mass energy it releases; with Q = 0 and nonnegative products the outgoing particle and every secondary carry at most E_pre, and balanced steps telescope along a track (energy handed on = E_0 - E_n + sum Q).",
      "lean": {
        "file": "formal/Trech/Laws/EnergyBalance.lean",
        "declarations": [
          "Trech.Laws.EnergyBalance.residual_eq_zero_iff",
          "Trech.Laws.EnergyBalance.post_le_pre",
          "Trech.Laws.EnergyBalance.secondary_le_pre",
          "Trech.Laws.EnergyBalance.track_released_sum"
        ]
      },
      "classic": [
        {"path": "include/trech/sim/EnergyBalance.hpp", "cites": "Trech.Laws.EnergyBalance"}
      ],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["energy.step_balance", "energy.post_le_pre", "energy.conversion_balance", "energy.track_released_sum"]}
    },
    {
      "id": "compton.four_momentum",
      "role": "reference",
      "statement": "For a photon (|k| = E) scattering off an electron of mass m at rest into a photon (|k'| = E') and an electron on its mass shell (Ee^2 = |p|^2 + m^2), energy and momentum conservation give m (E - E') = E E' - k.k', i.e. E' (m + E (1 - cos theta)) = m E.",
      "lean": {
        "file": "formal/Trech/Laws/TwoBody.lean",
        "declarations": [
          "Trech.Laws.TwoBody.compton_invariant",
          "Trech.Laws.TwoBody.compton_relation"
        ]
      },
      "classic": [
        {"path": "include/trech/sim/KleinNishina.hpp", "cites": "Trech.Laws.TwoBody"},
        {"path": "include/trech/sim/EnergyBalance.hpp", "cites": "Trech.Laws.TwoBody"}
      ],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["compton.momentum_balance"]}
    },
    {
      "id": "lattice.collision_conserves_mass",
      "role": "method_property",
      "statement": "The two-relaxation-time collision keeps a cell's summed populations when the equilibrium carries the same mass, a zero-sum source keeps it, and pull streaming along a bijection of the links keeps the lattice total.",
      "lean": {
        "file": "formal/Trech/Methods/Lattice.lean",
        "declarations": [
          "Trech.Methods.Lattice.relaxTRT_sum_eq",
          "Trech.Methods.Lattice.sum_add_zero_source",
          "Trech.Methods.Lattice.stream_sum_eq"
        ]
      },
      "classic": [
        {"path": "src/core/LatticeKinetic.cpp", "cites": "Trech.Methods.Lattice"}
      ],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["lattice.velocity_moments", "lattice.opposite_involution", "lattice.streaming_bijection", "lattice.collision_conserves_mass"]}
    },
    {
      "id": "lattice.scalar_conserves_total",
      "role": "method_property",
      "statement": "The scalar (advection-diffusion) equilibrium w_k v (1 + c_k.u / cs2) carries the cell value v when sum w = 1 and sum w c = 0; with the TRT collision and bijective pull streaming, a scalar lattice with zero-flux walls and no source conserves its total.",
      "lean": {
        "file": "formal/Trech/Methods/Lattice.lean",
        "declarations": [
          "Trech.Methods.Lattice.advectedEquilibrium_sum",
          "Trech.Methods.Lattice.relaxTRT_sum_eq",
          "Trech.Methods.Lattice.stream_sum_eq"
        ]
      },
      "classic": [
        {"path": "src/core/LatticeKinetic.cpp", "cites": "Trech.Methods.Lattice"},
        {"path": "src/core/LatticeContinuum.cpp", "cites": "Trech.Methods.Lattice"}
      ],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["lattice.scalar_conserves_total"]}
    },
    {
      "id": "transition.step_probability",
      "role": "method_property",
      "statement": "The engine's two-stage transition draw (no transition when u >= h, else the channel whose cumulative score interval holds (u / h) S) fires channel c with probability h s_c / S: nonnegative, summing to h <= 1, leaving 1 - h for no transition, and equal to s_c in direct mode below renormalisation.",
      "lean": {
        "file": "formal/Trech/Methods/Transition.lean",
        "declarations": [
          "Trech.Methods.Transition.stepProbability_nonneg",
          "Trech.Methods.Transition.sum_stepProbability",
          "Trech.Methods.Transition.noEvent_nonneg",
          "Trech.Methods.Transition.stepProbability_direct",
          "Trech.Methods.Transition.channelDraw_lt_iff"
        ]
      },
      "classic": [
        {"path": "src/ml/DiscreteTransition.cpp", "cites": "Trech.Methods.Transition"},
        {"path": "include/trech/ml/DiscreteTransition.hpp", "cites": "Trech.Methods.Transition"}
      ],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["transition.outcomes_probability_vector", "transition.channel_probability"]}
    },
    {
      "id": "transition.declared_conservation",
      "role": "invariant",
      "statement": "An atomic discrete channel with zero weighted change preserves the declared integer total. All counts remain in range when all started in range, including when the change is rejected.",
      "lean": {
        "file": "formal/Trech/Methods/Transition.lean",
        "declarations": [
          "Trech.Methods.Transition.applyChannel_conserves",

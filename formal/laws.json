      "classic": [{"path": "src/ml/DiscreteTransition.cpp", "cites": "Trech.Methods.Transition"}],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["transition.declared_conservation", "transition.nonnegative_counts"]}
    },
    {
      "id": "pair.exchange_conserves_total",
      "role": "invariant",
      "statement": "Over the reals, an antisymmetric pair preserves the sum of a field when both the increment and the time-integrated rate are applied with opposite signs and no bounds clip the resulting state.",
      "lean": {
        "file": "formal/Trech/Methods/PairInteraction.lean",
        "declarations": ["Trech.Methods.PairInteraction.exchange_preserves_sum"]
      },
      "classic": [{"path": "src/ml/PairInteraction.cpp", "cites": "Trech.Methods.PairInteraction"}],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["pair.antisymmetric_exchange", "pair.exchange_conserves_total"]}
    },
    {
      "id": "arbiter.squared_score_proper",
      "role": "method_property",
      "statement": "Over any weighted sample the squared score sum w (x - p)^2 equals the mean's score plus (sum w)(m - p)^2, so the weighted mean minimises it (strictly for positive weight); log(error + floor) with floor > 0 keeps the order of nonnegative errors.",
      "lean": {
        "file": "formal/Trech/Methods/Arbiter.lean",
        "declarations": [
          "Trech.Methods.Arbiter.squaredScore_decompose",
          "Trech.Methods.Arbiter.squaredScore_mean_le",

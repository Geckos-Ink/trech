    },
    {
      "id": "arbiter.squared_score_proper",
      "role": "method_property",
      "statement": "Over any weighted sample the squared score sum w (x - p)^2 equals the mean's score plus (sum w)(m - p)^2, so the weighted mean minimises it (strictly for positive weight); log(error + floor) with floor > 0 keeps the order of nonnegative errors.",
      "lean": {
        "file": "formal/Trech/Methods/Arbiter.lean",
        "declarations": [
          "Trech.Methods.Arbiter.squaredScore_decompose",
          "Trech.Methods.Arbiter.squaredScore_mean_le",
          "Trech.Methods.Arbiter.squaredScore_mean_lt",
          "Trech.Methods.Arbiter.logError_lt_iff"
        ]
      },
      "classic": [
        {"path": "src/ml/MethodArbiter.cpp", "cites": "Trech.Methods.Arbiter"}
      ],
      "conformance": {"test": "tests/test_formal_laws.cpp", "checks": ["arbiter.mean_scores_lowest", "arbiter.mean_leads"]}
    },
    {
      "id": "arbiter.decayed_scores",
      "role": "method_property",
      "statement": "A score updated once per graded call by s <- lam s + x equals sum lam^(T-1-t) x_t after T calls (so a decayed mean is a weighted mean with weights lam^age) and, for lam >= 0, is monotone in each contribution; when two methods predicted in the same calls, the one no worse on every call has a decayed mean log error no greater, strictly so when strictly better on one weighted call (lam > 0); without shared calls the ranking can invert.",
      "lean": {
        "file": "formal/Trech/Methods/Decay.lean",
        "declarations": [
          "Trech.Methods.Decay.decayed_eq_sum",
          "Trech.Methods.Decay.decayed_mono",
          "Trech.Methods.Decay.decayed_nonneg",
          "Trech.Methods.Decay.decayedMean_le",
          "Trech.Methods.Decay.decayedMean_lt",
          "Trech.Methods.Decay.decayedMean_needs_common_calls"
        ]
      },
      "classic": [
        {"path": "include/trech/ml/DecayedScore.hpp", "cites": "Trech.Methods.Decay"},
        {"path": "src/ml/MethodArbiter.cpp", "cites": "Trech.Methods.Decay"}
